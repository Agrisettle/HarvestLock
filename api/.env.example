# Copy to .env and fill in. Never commit the real .env.

# Postgres
DATABASE_URL=postgres://postgres:harvestlock@localhost:5432/harvestlock

# Stellar
# The network passphrase is what actually selects the network. There is
# deliberately no STELLAR_NETWORK variable here: one used to sit in this
# file, but no code ever read it (checked with grep across src/, scripts/
# and test/), so setting it silently did nothing -- removed by the .env
# audit rather than left as a stale entry that looks like it matters.
# The passphrase must match the network STELLAR_RPC_URL points at; rpc.ts
# falls back to the testnet passphrase if unset.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# The escrow WASM's hash, so the API can deploy fresh commitment
# instances without re-uploading the contract every time. Get this
# from `stellar contract build`'s output, or from an existing
# deployment via `stellar contract info` — never hardcode a specific
# CONTRACT_ID here, since one contract instance is one commitment
# (PRD §4.8) and the API creates a new instance per commitment.
ESCROW_WASM_HASH=

# An account that pays the network fee for deploying new commitment
# contracts. Not a party to any commitment itself — separate from the
# buyer/cooperative/warehouse keys, which sign their own actions.
DEPLOYER_SECRET_KEY=

# Protection for POST /commitments/deploy (the deployer pays real XLM per
# call, and the same key is the source account for every chain read):
# - per-IP limit on that route only (defaults: 5 per 10 minutes)
# - the route returns 503 when the deployer's XLM balance is below the
#   floor (default 10 XLM) and logs a warning below the warn level
#   (default 25 XLM). Whole XLM.
DEPLOY_RATE_LIMIT_MAX=5
DEPLOY_RATE_LIMIT_WINDOW_MS=600000
DEPLOYER_MIN_BALANCE_XLM=10
DEPLOYER_BALANCE_WARN_XLM=25

PORT=3000

# Member SMS notifications (src/notifications.ts, issue #7).
# "log" (default) sends NOTHING -- it logs each message with the number
# redacted. "termii" sends real SMS and needs the two TERMII_* values;
# the API refuses to boot with termii and no key rather than silently
# falling back to log. Never set termii in CI or for local testing.
SMS_PROVIDER=log
# en | yo | ha | ig -- the reviewed copy in docs/sms-templates*.md.
SMS_LOCALE=en
TERMII_API_KEY=
TERMII_SENDER_ID=
# "dnd" (default) or "generic". PRD §17 chose Termii for DND handling:
# Nigeria's DND registry silently drops transactional SMS on the generic
# route. dnd needs the sender ID approved for it. Base URL only needs
# changing for a non-default Termii region.
TERMII_CHANNEL=dnd
TERMII_BASE_URL=https://api.ng.termii.com

# Buyer KYB via anchor SEP-10/SEP-12 (src/kyb.ts, issue #11).
# "off" (default): verification is available but never required.
# "enforce": an unverified buyer can't be put on a new commitment or
# take one over via reassignment. enforce needs >= 1 trusted anchor.
KYB_ENFORCEMENT=off
# Comma-separated bare home domains, e.g. testanchor.stellar.org for testnet.
KYB_TRUSTED_ANCHORS=
# How long an ACCEPTED check counts (PRD: buyers re-verified every 6 months).
KYB_VALIDITY_DAYS=182
# Optional anchor-specific SEP-12 customer `type` to query.
KYB_SEP12_CUSTOMER_TYPE=

# Exact browser origins allowed to call the API, comma-separated. Leave
# empty until the deployed frontend domains are known; local frontend
# development can use e.g. http://localhost:5173.
CORS_ORIGINS=

# Only "test" is special to this API: server.ts skips the global rate
# limiter under it so the test suites' rapid-fire requests against one
# shared app don't trip it. Vitest sets NODE_ENV=test itself, so `npm
# test` doesn't depend on a value here; any other value, or unset, keeps
# rate limiting on — normal local development doesn't need to set it.
NODE_ENV=development
