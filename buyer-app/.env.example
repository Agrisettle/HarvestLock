# Copy to .env and adjust if the API isn't running on the default port.
VITE_API_URL=http://localhost:3000

# Optional -- links the create-commitment form's Roles & Responsibilities
# consent checkbox to the marketing site's roles.html. Unset by default:
# there's no deployed site domain yet (see site/README.md), so the
# checkbox degrades to plain, non-linked text rather than a broken link.
# For local dev against `site/`'s own dev server: VITE_SITE_URL=http://localhost:5173
#VITE_SITE_URL=
